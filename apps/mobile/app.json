{
  "expo": {
    "name": "Scottsdale Wine Trail",
    "slug": "scottsdale-wine-trail",
    "scheme": "swt",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#FBF7EF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.scottsdalewinetrail.app"
    },
    "android": {
      "package": "com.scottsdalewinetrail.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3D0A18",
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
