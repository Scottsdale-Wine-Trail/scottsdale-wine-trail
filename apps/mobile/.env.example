# Supabase — copy to .env and fill in. EXPO_PUBLIC_* vars are inlined at build time.
# Local Supabase (npx supabase start) prints these values.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# MVP "Stamp My Visit" employee/manual code. Staff enter this at the tasting
# room to stamp a guest's passport. Replace with per-winery codes later.
EXPO_PUBLIC_STAMP_CODE=TRAIL2026
